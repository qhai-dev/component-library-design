{
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter shadcn-semi-design test",
    "test:watch": "pnpm --filter shadcn-semi-design test:watch",
    "test-storybook": "pnpm --filter shadcn-semi-design test-storybook",
    "storybook": "pnpm --filter shadcn-semi-design storybook",
    "build-storybook": "pnpm --filter shadcn-semi-design build-storybook",
    "typecheck": "pnpm -r typecheck",
    "lint": "rslint packages",
    "lint:fix": "rslint --fix packages",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "dev:docs": "pnpm --filter docs dev",
    "dev:docs:src": "pnpm --filter docs dev:src",
    "test:browser": "rstest --config=rstest.browser.config.mts"
  },
  "dependencies": {
    "@rslib/core": "^1.0.5",
    "@rslint/core": "^0.10.0",
    "@rspress/core": "2.0.23",
    "@rstest/core": "^0.12.5"
  },
  "devDependencies": {
    "@rstest/browser": "^0.12.5",
    "@testing-library/dom": "^10.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.49.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.15.1"
    }
  }
}
