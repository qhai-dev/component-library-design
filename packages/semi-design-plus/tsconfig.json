{
    "compilerOptions": {
        "lib": ["DOM", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "useDefineForClassFields": true,
        "types": ["@rslib/core/types"]
    },
    "include": ["src"]
}
